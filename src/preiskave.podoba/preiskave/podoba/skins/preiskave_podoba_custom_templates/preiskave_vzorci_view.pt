<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      lang="en"
      metal:use-macro="here/main_template/macros/master"
      i18n:domain="plone">

<body>

    <div metal:fill-slot="main">
    <metal:main-macro define-macro="main"
                      tal:define="kssClassesView context/@@kss_field_decorator_view;
                                  getKssClasses nocall:kssClassesView/getKssClassesInlineEditable;
                                  templateId template/getId">

       
     
      
        <h1 metal:use-macro="here/kss_generic_macros/macros/generic_title_view">
            Title or id
        </h1>

        

        <p metal:use-macro="here/kss_generic_macros/macros/generic_description_view">
            Description
        </p>
        

        <div metal:define-macro="text-field-view"
             id="parent-fieldname-text" class="stx"
             tal:define="kss_class python:getKssClasses('text',
                         templateId=templateId, macro='text-field-view');
                         has_text exists:context/aq_base/getText;
                         text python:has_text and here.getText() or ''"
             tal:condition="text"
             tal:attributes="class python:test(here.Format() in ('text/structured',
                                                   'text/x-rst', ), 'stx' + kss_class, 'plain' + kss_class)">
            <div metal:define-slot="inside" tal:replace="structure text">The body</div>
        </div>

        <metal:listingmacro define-macro="listing">
        <tal:foldercontents define="contentFilter contentFilter|request/contentFilter|nothing;
                            limit_display limit_display|request/limit_display|nothing;
                            more_url more_url|request/more_url|string:folder_contents;
                            is_a_topic python:here.portal_type=='Topic';
                            folderContents folderContents|nothing; folderContents python:folderContents or is_a_topic and here.queryCatalog(contentFilter, batch=True) or here.getFolderContents(contentFilter, batch=True, b_size=limit_display or 100);
                            use_view_action site_properties/typesUseViewActionInListings|python:();
                            over_limit python: limit_display and len(folderContents) > limit_display;
                            folderContents python: (over_limit and folderContents[:limit_display]) or folderContents;
                            batch folderContents;
                            
                            folderContents python: context.portal_catalog(portal_type=['imipreiskava']);
                            parametri python: context.REQUEST.form.keys();
                            podrocje python: 'podrocje' in parametri and context.REQUEST.form['podrocje'] or '';
                            
                            iskanje_vzorec python: 'iskanje_vzorec' in parametri and context.REQUEST.form['iskanje_vzorec'] or podrocje or '';
                            nivo1 python: 'nivo1' in parametri and context.REQUEST.form['nivo1'] or '';
                            nivo2 python: 'nivo2' in parametri and context.REQUEST.form['nivo2'] or '';
                            nivo3 python: 'nivo3' in parametri and context.REQUEST.form['nivo3'] or '';
			    			nivo4 python: 'nivo4' in parametri and context.REQUEST.form['nivo4'] or '';
			    			nivo5 python: 'nivo5' in parametri and context.REQUEST.form['nivo5'] or '';
			    			nivo1 python: str(nivo1);
			    			nivo2 python: str(nivo2);
			    			nivo3 python: str(nivo3);
			    			nivo4 python: str(nivo4);
			    			nivo5 python: str(nivo5);">
        
        <tal:listing condition="folderContents" 
        tal:define="vsa_p python: context.portal_catalog.uniqueValuesFor('podrocje'); 
        vsa_p python: list(vsa_p);       
        
        slo_crke python: ['A', 'B', 'C', 'Č', 'D', 'E', 'F', 'G', 'H', 'I', 'J', 'K', 'L', 'M', 'N', 'O', 'P', 'R', 'S', 'Š', 'T', 'U', 'V', 'Z', 'Ž', 'Q', 'X', 'Y', 'W'];
        sumniki python: ['\xc4\x8c', '\xc4\x8d', '\xc5\xa0', '\xc5\xa1',  '\xc5\xbd', '\xc5\xbe'];
        sumniki2 python: ['\xc4\x8c', '\xc4\x8c', '\xc5\xa0', '\xc5\xa0',  '\xc5\xbd', '\xc5\xbd'];">
		   
        <div id="listing_preiskav" class="vzorci" tal:define="params python: iskanje_vzorec and {'moj': iskanje_vzorec, 'portal_type': 'imipreiskava'} or {'portal_type': 'imipreiskava'}; preiskave python: context.portal_catalog(**params);">
	          
	          <span class="trenutno">Trenutno izbrano področje preiskav</span><br />
	          <select class="podrocje_select" tal:define="novapot python: here.absolute_url()" tal:attributes="onchange python: 'location.href = \'' + novapot + '/?podrocje=\' + this.options[this.selectedIndex].value'">
	                                
	                <option tal:attributes="selected python: podrocje and '' or 'selected'" value="">VSA PODROČJA</option>
	                <tal:entry tal:repeat="mapa python: vsa_p">
		                <option tal:attributes="selected python: mapa == podrocje and 'selected' or ''" tal:content="mapa">
		                
		                </option>
			            
	                </tal:entry>           
	                
	          </select>
	          
	          
	          <span class="vijolcno"><<< &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Skrčite število preiskav samo na eno izbrano področje</span>
	          
	          <div class="vzorci_drobtine">
	              <span tal:condition="not: nivo1">vsi vzorci</span>
	              <span tal:condition="nivo1"><a tal:attributes="href python: here.absolute_url().split('?')[0] + '?podrocje=' + podrocje">vsi vzorci</a> > </span>
	              <span tal:condition="python: nivo1 and not nivo2" tal:content="nivo1"></span>
	              
		      <span tal:condition="nivo2" tal:define="iskanje python: podrocje and nivo1 + ' AND ' + podrocje or nivo1"> <a tal:attributes="href python: here.absolute_url().split('?')[0] + '?podrocje=' + podrocje + '&nivo1=' + nivo1 + '&iskanje_vzorec=' + iskanje" tal:content="nivo1"></a> > </span>
	              <span tal:condition="python: nivo2 and not nivo3" tal:content="nivo2"></span>
	              
		      <span tal:condition="nivo3" tal:define="iskanje python: podrocje and nivo1 + ' AND ' + nivo2 + ' AND ' + podrocje or nivo1 + ' AND ' + nivo2"> <a tal:attributes="href python: here.absolute_url().split('?')[0] + '?podrocje=' + podrocje + '&nivo1=' + nivo1 + '&nivo2=' + nivo2 + '&iskanje_vzorec=' + iskanje" tal:content="nivo2"></a> > </span>
	              <span tal:condition="python: nivo3 and not nivo4" tal:content="nivo3"> > </span>

		      <span tal:condition="nivo4" tal:define="iskanje python: podrocje and nivo1 + ' AND ' + nivo2 + ' AND ' + nivo3 + ' AND ' + podrocje or nivo1 + ' AND ' + nivo2 + ' AND ' + nivo3"> <a tal:attributes="href python: here.absolute_url().split('?')[0] + '?podrocje=' + podrocje + '&nivo1=' + nivo1 + '&nivo2=' + nivo2 + '&nivo3=' + nivo3 + '&iskanje_vzorec=' + iskanje" tal:content="nivo3"></a> > </span>
	              <span tal:condition="python: nivo4 and not nivo5" tal:content="nivo4"> > </span>

   		      <span tal:condition="nivo5" tal:define="iskanje python: podrocje and nivo1 + ' AND ' + nivo2 + ' AND ' + nivo3 + ' AND ' + nivo4 + ' AND ' + podrocje or nivo1 + ' AND ' + nivo2 + ' AND ' + nivo3 + ' AND ' + nivo4"> <a tal:attributes="href python: here.absolute_url().split('?')[0] + '?podrocje=' + podrocje + '&nivo1=' + nivo1 + '&nivo2=' + nivo2 + '&nivo3=' + nivo3 + '&nivo4=' + nivo4 + '&iskanje_vzorec=' + iskanje" tal:content="nivo4"></a> > </span>
	              <span tal:condition="nivo5" tal:content="nivo5"> > </span>
	                
	          </div>

	        <div class="centriraj">
		        <div class="container _container container-12 clearfix">
			        <div class="levo ena .container-9"></div>
		            <div class="levo dva .container-11"></div>
		            <div class="levo tri .container-13"></div>
			    </div>
			</div>

	          <ul class="ul" tal:define="nivo1_tab python: []; nivo2_tab python: []; nivo3_tab python: []; nivo4_tab python: []; nivo5_tab python: [];
	          dummy python: [nivo1_tab.append(x.split('###')[2]) for item in preiskave for x in item.getObject().vzorci if '###' in x and x.split('###')[2] not in nivo1_tab];
	          	          
	          dummy python: nivo1 and [nivo2_tab.append(x.split('###')[3]) for item in preiskave for x in item.getObject().vzorci if nivo1 in x and '###' in x and x.split('###')[3] not in nivo2_tab];
	          
	          dummy python: nivo2 and [nivo3_tab.append(x.split('###')[4]) for item in preiskave for x in item.getObject().vzorci if nivo2 in x and '###' in x and x.split('###')[4] not in nivo3_tab];
	 		  
	 		  dummy python: nivo3 and [nivo4_tab.append(x.split('###')[5]) for item in preiskave for x in item.getObject().vzorci if nivo3 in x and '###' in x and x.split('###')[5] not in nivo4_tab];
			  
			  dummy python: nivo4 and [nivo5_tab.append(x.split('###')[6]) for item in preiskave for x in item.getObject().vzorci if nivo4 in x and '###' in x and x.split('###')[6] not in nivo5_tab];
	           
	          ">
<!--
	         <div tal:define="test python: []; dummy python: [test.append(x.split('###')[3]) for item in preiskave for x in item.getObject().vzorci if '###' in x and x.split('###')[3] not in test];" tal:content="python: preiskave"></div>
-->
                 
                 <tal:entry tal:repeat="mapa nivo1_tab" tal:condition="python: not nivo1">
		                <div class="razvrsti" tal:condition="python: mapa != ''">
		                	<a tal:define="iskanje python: podrocje and mapa + ' AND ' + podrocje or mapa" tal:attributes="href python: here.absolute_url().split('?')[0] + '?podrocje=' + podrocje + '&nivo1=' + mapa + '&iskanje_vzorec=' + iskanje" tal:content="python: mapa" tal:condition="python: mapa != ''" />
		                </div>
			            
	                </tal:entry> 
	                
	                <tal:entry tal:repeat="mapa nivo2_tab" tal:condition="python: nivo1 and not nivo2">
		                <div class="razvrsti"  tal:condition="python: mapa != ''" >
		                	<a tal:define="iskanje python: podrocje and nivo1 + ' AND ' + mapa + ' AND ' + podrocje or nivo1 + ' AND ' + mapa" tal:attributes="href python: here.absolute_url().split('?')[0] + '?podrocje=' + podrocje + '&nivo1=' + nivo1 + '&nivo2=' + mapa + '&iskanje_vzorec=' + iskanje" tal:content="python: mapa" tal:condition="python: mapa != ''" />
		                </div>
			            
	                </tal:entry> 
	                
	                <tal:entry tal:repeat="mapa nivo3_tab" tal:condition="python: nivo2 and not nivo3">
		                <div class="razvrsti"  tal:condition="python: mapa != ''">
		                	<a tal:define="iskanje python: podrocje and nivo1 + ' AND ' + nivo2 + ' AND ' + mapa + ' AND ' + podrocje or nivo1 + ' AND ' + nivo2 + ' AND ' + mapa" tal:attributes="href python: here.absolute_url().split('?')[0] + '?podrocje=' + podrocje + '&nivo1=' + nivo1 + '&nivo2=' + nivo2 + '&nivo3=' + mapa + '&iskanje_vzorec=' + iskanje" tal:content="python: mapa" tal:condition="python: mapa != ''" />
		                </div>
			            
	                </tal:entry>   

			<tal:entry tal:repeat="mapa nivo4_tab" tal:condition="python: nivo3 and not nivo4">
		                <div class="razvrsti"  tal:condition="python: mapa != ''">
		                	<a tal:define="iskanje python: podrocje and nivo1 + ' AND ' + nivo2 + ' AND ' + nivo3 + ' AND ' + mapa + ' AND ' + podrocje or nivo1 + ' AND ' + nivo2 + ' AND ' + nivo3 + ' AND ' + mapa" tal:attributes="href python: here.absolute_url().split('?')[0] + '?podrocje=' + podrocje + '&nivo1=' + nivo1 + '&nivo2=' + nivo2 + '&nivo3=' + nivo3 + '&nivo4=' + mapa + '&iskanje_vzorec=' + iskanje" tal:content="python: mapa" tal:condition="python: mapa != ''" />
		                </div>
			            
	                </tal:entry> 

			<tal:entry tal:repeat="mapa nivo5_tab" tal:condition="python: nivo4 and not nivo5">
		                <div class="razvrsti"  tal:condition="python: mapa != ''">
		                	<a tal:define="iskanje python: podrocje and nivo1 + ' AND ' + nivo2 + ' AND ' + nivo3 + ' AND ' + nivo4 + ' AND ' + mapa + ' AND ' + podrocje or nivo1 + ' AND ' + nivo2 + ' AND ' + nivo3 + ' AND ' + nivo4 + ' AND ' + mapa" tal:attributes="href python: here.absolute_url().split('?')[0] + '?podrocje=' + podrocje + '&nivo1=' + nivo1 + '&nivo2=' + nivo2 + '&nivo3=' + nivo3 + '&nivo4=' + nivo4 + '&nivo5=' + mapa + '&iskanje_vzorec=' + iskanje" tal:content="python: mapa" tal:condition="python: mapa != ''" />
		                </div>
			            
	                </tal:entry>               

	                
	                
	                
	              
	                
	          </ul>	          
	          
             
          
	          <div id="divi_preiskav">
	               
	                    <div tal:attributes="class python: ''.join(filter(lambda x: ord(x)<128, podrocje)).replace(' ', '_')" tal:define="
	                    preiskave_podrocje python: preiskave;	                    
	                     	 
	                    vse_c python: {};                   
	                    "
	                    >
	                    
	                    <h2 class="printskrit" tal:content="podrocje" />
	                    
	                    <tal:entry3 tal:repeat="pre preiskave_podrocje">
											 <tal:zo tal:define="moj python: pre.Title[:2]; crka python: (moj in sumniki) and sumniki2[sumniki.index(moj)] or pre.Title[0].upper(); 
											  
											  contents python: vse_c.update({crka:[]});
											  " />			       
										  </tal:entry3>
										  
										   <tal:entry3 tal:repeat="pre preiskave_podrocje">
											 <tal:zo tal:define="moj python: pre.Title[:2]; crka python: (moj in sumniki) and sumniki2[sumniki.index(moj)] or pre.Title[0].upper(); 											  
											  contents python: vse_c.get(crka, []).append(pre);
											  " />
										  </tal:entry3>
	                    
	                    
	                    		<ul class="izbirnik_crk">
	                        
															  <tal:entry tal:repeat="crka python: vse_c.keys()">
																  <li class="preiskave_crke" tal:attributes="id crka" tal:content="crka" />			            
															  </tal:entry>
													</ul>
													<div class="locnica_druga" style="clear:both"></div>
													<tal:entry2 tal:repeat="crka python: vse_c.keys()">													
																
																<div tal:attributes="class python: crka + ' crke_skrito preiskave odprto'" tal:define="preiskave_crke python: vse_c[crka];">
																		
																		<div class="velika_crka" tal:content="crka" />
																		<ul>
																							<tal:entry2 tal:repeat="item2 preiskave_crke" >
																							    <li tal:attributes="title python: item2.Title">
																							    	<a tal:attributes="href python:item2.getURL() + '?podrocje=' + podrocje;" tal:content="python: item2.Title" />
																							    </li>
																							</tal:entry2>	
																			</ul>
																			
																</div>
	                    		 </tal:entry2>
	                    </div>
	                
	                
	                
	          </div>
                
         
         
        </div>  
        
        
             
            
        
        <div tal:replace="structure provider:plone.belowcontentbody" />
                        
        </tal:listing>
       
        </tal:foldercontents>
        </metal:listingmacro>



    </metal:main-macro>
    </div>
    
    

</body>
</html>
