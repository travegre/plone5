<configure
    xmlns="http://namespaces.zope.org/zope"
    i18n_domain="dezurstva.produkti">

  <!-- Dexterity content types are registered via the FTI in profiles/default/types/ -->

  <subscriber
      for="dezurstva.produkti.content.dezurstvo.dezurstvo
           zope.lifecycleevent.interfaces.IObjectCreatedEvent"
      handler="dezurstva.produkti.content.dezurstvo.on_object_created"
  />
  <subscriber
      for="dezurstva.produkti.content.dezurstvo.dezurstvo
           zope.lifecycleevent.interfaces.IObjectModifiedEvent"
      handler="dezurstva.produkti.content.dezurstvo.on_object_modified"
  />

  <subscriber
      for="dezurstva.produkti.content.seznam_zaposlenih.seznam_zaposlenih
           zope.lifecycleevent.interfaces.IObjectCreatedEvent"
      handler="dezurstva.produkti.content.seznam_zaposlenih.on_object_created"
  />
  <subscriber
      for="dezurstva.produkti.content.seznam_zaposlenih.seznam_zaposlenih
           zope.lifecycleevent.interfaces.IObjectModifiedEvent"
      handler="dezurstva.produkti.content.seznam_zaposlenih.on_object_modified"
  />

</configure>
