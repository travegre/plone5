<metal:page define-macro="master">
<tal:doctype tal:replace="structure string:&lt;!DOCTYPE html PUBLIC
  &quot;-//W3C//DTD XHTML 1.0 Transitional//EN&quot;
  &quot;http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd&quot;&gt;" />

<html xmlns="http://www.w3.org/1999/xhtml"
    tal:define="portal_state context/@@plone_portal_state;
        context_state context/@@plone_context_state;
        plone_view context/@@plone;
        lang portal_state/language;
        view nocall:view | nocall: plone_view;
        dummy python: plone_view.mark_view(view);
        portal_url portal_state/portal_url;
        checkPermission nocall: context/portal_membership/checkPermission;
        site_properties context/portal_properties/site_properties;
        ajax_load request/ajax_load | nothing;
        ajax_include_head request/ajax_include_head | nothing"
    tal:attributes="lang lang;">

    <metal:cache use-macro="context/global_cache_settings/macros/cacheheaders">
    Get the global cache headers located in global_cache_settings.
    </metal:cache>

<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />

    <tal:comment replace="nothing">
      Forces IE8+ into newest rendering engine even if on an intranet. This has to be defined before any script/style tags.
    </tal:comment>
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <metal:baseslot define-slot="base">
        <base tal:attributes="href plone_view/renderBase" /><!--[if lt IE 7]></base><![endif]-->
    </metal:baseslot>

    
    <script type="text/javascript" src="jquery-1.5.1.min.js"></script> 
    <link rel="stylesheet" href="dezurstva.css" type="text/css" />  

    <script type="text/javascript" src="jquery.tinysort.js"></script>

    <script>
	$(document).ready(function() {
		$('select#oseba option, select#izvoz-2-oseba option').tsort();
	});



    </script> 
    
</head>

<body tal:define="isRTL portal_state/is_rtl;
                  sl python:plone_view.have_portlets('plone.leftcolumn', view);
                  sr python:plone_view.have_portlets('plone.rightcolumn', view);
                  body_class python:plone_view.bodyClass(template, view);
                  sunburst_view python:context.restrictedTraverse('@@sunburstview');
		lan python: context.portal_languages.getPreferredLanguage();
                    dod python: lan != 'sl' and ('-' + lan) or '';
                    
                    url_tokens python: context.REQUEST.getURL().split('/');
                    is_front python: context.absolute_url() == portal_url;
                    
                    prva python: is_front and 'prva_stran' or '';
		 last_change python: context.portal_catalog(portal_type = 'dezurstvo', sort_on = 'modified', sort_order = 'descending')[0]"
    tal:attributes="class body_class;
                    dir python:isRTL and 'rtl' or 'ltr'">

	<div id="last-change">	
		<span>Zadnja sprememba: </span><span tal:define="datum last_change/modified; dat python: '.'.join([str(datum).split(' ')[0].split('/')[2], str(datum).split(' ')[0].split('/')[1], str(datum).split(' ')[0].split('/')[0]])" tal:content="dat" /> 
		<span> ob </span>
		<span tal:define="datum last_change/modified; dat python: ':'.join([str(datum).split(' ')[1].split(':')[0], str(datum).split(' ')[1].split(':')[1]])" tal:content="dat" />
	</div>
                    
    
	<script type="text/JavaScript">
        	var now = new Date();
		var night = new Date(
		    now.getFullYear(),
		    now.getMonth(),
		    now.getDate() + 1, // the next day, ...
		    0, 0, 10 // ...at 00:00:00 hours
		);
		var msTillMidnight = night.getTime() - now.getTime();
		if (msTillMidnight > 0) setTimeout('location.reload(true)', msTillMidnight);

      </script>
	<div id="okolo">
          <div id="okol" >              
		            <a tal:attributes="href portal_url"><img id="logo" src="dezurstva/logo.png" /></a>
		            
		            <h1><a tal:attributes="href portal_url"> DEŽURSTVA IN PRIPRAVLJENOST</a></h1>               
              		
			





		
	





	<div tal:define="dans python: str(DateTime()).split(' ')[0].replace('/', '-'); dat here/REQUEST/form/datum|nothing; danes python: dat and dat or str(DateTime()).split(' ')[0].replace('/', '-'); dezurstvo python: context.portal_catalog(portal_type = 'dezurstvo', id = danes); dezurstvo python: len(dezurstvo) > 0 and dezurstvo[0] or nothing; oseba here/REQUEST/form/oseba|nothing; seznam python: oseba and context.portal_catalog.searchResults(dezurni_zdravnik = oseba, portal_type = 'dezurstvo', sort_on='id', sort_order='ascending') or nothing; dnevi python: {'Monday':'ponedeljek', 'Tuesday':'torek', 'Wednesday':'sreda', 'Thursday':'četrtek', 'Friday':'petek', 'Saturday':'sobota', 'Sunday':'nedelja'}" tal:condition="python: 'spremeni-dezurstvo' not in url_tokens">

	
<tal:ret condition="not: oseba">
		
	<a style="margin-top: 14px; width: 28%; margin-right: 5%; float: left; text-align: right; font-size: 24px; font-family: Tahoma, sans-serif" tal:attributes="href python: '?datum=' + str(DateTime(danes) - 1).split(' ')[0].replace('/', '-')">Nazaj</a>
	<h2 style="width: 33%; float: left; text-align: center"><tal:tr condition="python: dans == danes">danes, </tal:tr><tal:tr content="python: dnevi[DateTime(danes).strftime('%A')] + ', ' + '.'.join([danes.split('-')[2], danes.split('-')[1], danes.split('-')[0]])"></tal:tr></h2>
	<a style="margin-top: 14px; width: 25%; margin-left: 5%; float: left; text-align: left; font-size: 24px;  font-family: Tahoma, sans-serif" tal:attributes="href python: '?datum=' + str(DateTime(danes) + 1).split(' ')[0].replace('/', '-')">Naprej</a>		
	<div style="clear: both">&nbsp;</div>
	
	<br />
	
	<tal:kerw condition="dezurstvo">
	<div style="display: inline-block; width:49%; float: left;">
	  <h2 style="text-align: left">DEŽURNA EKIPA</h2>
	  <p></p>
	  <table id = "levaTabela" cellpading="0" cellspacing="0" tal:condition="dezurstvo" style="vertical-align: top">
		  <tal:kr define="lista python: dezurstvo.getObject().dezurni_zdravnik">
			  <tr style="background: white !important" tal:repeat="el lista">
				  <td>dežurni zdravnik</td>
				  <td style="background: white !important" tal:define="oseba python: context.portal.restrictedTraverse('dezurstva/seznam_zaposlenih/' + el)" tal:content="oseba/Title"></td>
