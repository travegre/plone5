	<p tal:condition="not: dezurstvo">Dežurne ekipe in razpored stanja pripravljenosti za ta datum še niso določeni.</p> 
	

	
	


</tal:ret>

<tal:ret condition="oseba" define="leta python: []; mesci python: []; dummy python: oseba and [leta.append(x.id[:4]) for x in seznam if x.id[:4] not in leta]; dummy python: oseba and [mesci.append(x.id[5:7]) for x in seznam if x.id[5:7] not in mesci]; meseci python: {'01':'januar', '02':'februar', '03':'marec', '04':'april', '05':'maj', '06':'junij', '07':'julij', '08':'avgust', '09':'september', '10':'oktober', '11':'november', '12':'december'}; dummy python: mesci.sort(reverse=True); dummy python: leta.sort(reverse=True)">
	



	<h2>Dežurstva za osebo <span style="color: #5fb11e" tal:content="python: context.portal_catalog(id=oseba)[0].getObject().Title()"></span></h2>
		
	<p>&nbsp;</p>
	<tal:rep1 repeat="leto leta">
		<h3 tal:content="leto"></h3>	
		<tal:rep2 repeat="mesec mesci">	
			<h4 tal:content="python: meseci[mesec]"></h4>	
			<tal:rep3 define="seznam2 python: [x.id for x in seznam if (leto + '-' + mesec) in x.id]; dummy python: seznam2.sort(reverse=True)" repeat="item seznam2">				
				<a style="font-family: Tahoma, sans-serif;" tal:attributes="href python: '?datum=' + item" tal:content="python: '.'.join([item.split('-')[2], item.split('-')[1], item.split('-')[0]])">Nazaj</a><br />
			</tal:rep3>
		</tal:rep2>
	</tal:rep1>
	<p>&nbsp;</p>
	

	

</tal:ret>


<p>&nbsp;</p>
<hr />

	<link rel="stylesheet" href="jquery-ui.min.css" type="text/css" media="screen, projection" />	  
	<script type="text/javascript" src="jquery-ui.min.js"></script> 
  	
	<script>

	function DoSubmit(){
		var nov = document.poslji_datum.datum.value;	 
		nov = nov.split('.')[2] + '-' + nov.split('.')[1] + '-' + nov.split('.')[0];
		document.poslji_datum.datum.value = nov;
	  	return true;
	}



	  $(function() {
	    $( ".datepicker" ).datepicker({
	      dateFormat: "dd.mm.yy",
	      firstDay: 1 // Start with Monday
	    });
	  });
	</script>
	
	<div style="float: left; width: 49%">	
	<form action="" onsubmit="DoSubmit();" name="poslji_datum">
		<p>Prikaži razpored na izbrani datum: </p><input name="datum" tal:attributes="value python: '.'.join([danes.split('-')[2], danes.split('-')[1], danes.split('-')[0]])" type="text" class="datepicker">
		<input style="display: inline" type="submit" value="Prikaži" style="cursor: pointer" />
	</form>
	</div>
	
	<div style="float: left; width: 49%">	
	<form action="">
		<p>Prikaži vsa dežurstva za osebo:</p>
		<select name="oseba" id="oseba">
			<option></option>				
			<tal:rep repeat="os python: context['seznam_zaposlenih'].getFolderContents(contentFilter={'sort_on':'getObjPositionInParent'})">
				<option tal:attributes="value os/id" tal:content="os/Title"></option>
			</tal:rep>
		</select>
		<input style="display: inline" type="submit" value="Prikaži" style="cursor: pointer" />
	</form>
	</div>

	<div style="clear: both">&nbsp;</div>
	<div style="clear: both">&nbsp;</div>
	<div style="clear: both">&nbsp;</div>
	
	<a tal:condition="python: dezurstvo and not oseba" style="text-align: center; font-size: 16px" tal:attributes="href python: '/dezurstva/spremeni-dezurstvo?datum=' + danes">Za spremembo dežurstva lahko zaprosite tukaj</a>



	


	<!-- IZVOZ -->





	
	<p>&nbsp;</p>
	<hr />
	<br />

	<h2>IZVOZ</h2>
	<div style="clear: both">&nbsp;</div>
		
	<script>
	$('#izvoz-1-izbira').live('change', function (e) {	    
	    var optionSelected = $("option:selected", this);
	    var valueSelected = this.value;
	    
	    if (valueSelected == 'oddo') $('#oddo').show();
	    else $('#oddo').hide();

	    if (valueSelected != '') $('#izvoz-1 .submit').show();
	    else $('#izvoz-1 .submit').hide();
	});

	$('#izvoz-2-oseba').live('change', function (e) {	    
	    var optionSelected = $("option:selected", this);
	    var valueSelected = this.value;
	    
	    if (valueSelected != '') {
		$('#obdobje').show();
	    }
	    else {
		$('#obdobje').hide();
		$('#oddo-2').hide();
		$('#izvoz-2 .submit').hide();
	    }
	});

	$('#izvoz-2-izbira').live('change', function (e) {	    
	    var optionSelected = $("option:selected", this);
	    var valueSelected = this.value;
	    
	    if (valueSelected == 'oddo') $('#oddo-2').show();
	    else $('#oddo-2').hide();

	    if (valueSelected != '') $('#izvoz-2 .submit').show();
	    else $('#izvoz-2 .submit').hide();
	});

	
	</script>








	<div style="float: left; width: 49%">	
	<form action="/dezurstva/izvoz" name="izvoz-1" id="izvoz-1">
		<p>Izberite obdobje: </p>
		<select name="izvoz-1-izbira" id="izvoz-1-izbira">
			<option></option>
			<option value="teden">za prejšnji teden</option>
			<option value="tedenplus2">za naslednja 2 tedna</option>
			<option value="tekoci">za tekoči mesec</option>
			<option value="pretekli">za pretekli mesec</option>
			<option value="oddo">izvozi od do</option>
		</select>
		<br />
		<br />

		<div id="oddo">
			Od: <input name="od" tal:attributes="value python: '.'.join([danes.split('-')[2], danes.split('-')[1], danes.split('-')[0]])" type="text" class="datepicker">
			<br />
			Do: <input name="do" tal:attributes="value python: '.'.join([danes.split('-')[2], danes.split('-')[1], danes.split('-')[0]])" type="text" class="datepicker">
		</div>
		<br />
		

		<input class="submit" type="submit" value="Izvozi" style="cursor: pointer" />
	</form>
	</div>
	
	

	





	<div style="float: left; width: 49%">	
	<form action="/dezurstva/izvoz" name="izvoz-2" id="izvoz-2">
		<p>Izberite osebo in nato obdobje:</p>
		<select name="izvoz-2-oseba" id="izvoz-2-oseba">
			<option value=""></option>				
			<tal:rep repeat="os python: context['seznam_zaposlenih'].getFolderContents(contentFilter={'sort_on':'getObjPositionInParent'})">
				<option tal:attributes="value os/id" tal:content="os/Title"></option>
			</tal:rep>
		</select>
		
		<div id="obdobje">
		<p>Izberite obdobje: </p>
		<select name="izvoz-2-izbira" id="izvoz-2-izbira">
			<option></option>
			<option value="teden">za prejšnji teden</option>
			<option value="tedenplus2">za naslednja 2 tedna</option>
			<option value="tekoci">za tekoči mesec</option>
			<option value="pretekli">za pretekli mesec</option>
			<option value="oddo">izvozi od do</option>
		</select>
		<br />
		<br />
		</div>

		<div id="oddo-2">
			Od: <input name="od" tal:attributes="value python: '.'.join([danes.split('-')[2], danes.split('-')[1], danes.split('-')[0]])" type="text" class="datepicker">
			<br />
			Do: <input name="do" tal:attributes="value python: '.'.join([danes.split('-')[2], danes.split('-')[1], danes.split('-')[0]])" type="text" class="datepicker">
		</div>
		<br />
		
		<input class="submit" type="submit" value="Izvozi" style="cursor: pointer" />
	</form>
	</div>




















</div>


<metal:bodytext define-slot="main" tal:condition="python: 'spremeni-dezurstvo' in url_tokens">

