<metal:page define-macro="master">
<tal:doctype tal:replace="structure string:&lt;!DOCTYPE html PUBLIC
  &quot;-//W3C//DTD XHTML 1.0 Transitional//EN&quot;
  &quot;http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd&quot;&gt;" />

<html xmlns="http://www.w3.org/1999/xhtml"
    tal:define="portal_state context/@@plone_portal_state;
        context_state context/@@plone_context_state;
        plone_view context/@@plone;
        lang portal_state/language;
        view nocall:view | nocall: plone_view;
        dummy python: plone_view.mark_view(view);
        portal_url portal_state/portal_url;
        checkPermission nocall: context/portal_membership/checkPermission;
        site_properties context/portal_properties/site_properties;
        ajax_load request/ajax_load | nothing;
        ajax_include_head request/ajax_include_head | nothing"
    tal:attributes="lang lang;">

    <metal:cache use-macro="context/global_cache_settings/macros/cacheheaders">
    Get the global cache headers located in global_cache_settings.
    </metal:cache>

<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />

    <tal:comment replace="nothing">
      Forces IE8+ into newest rendering engine even if on an intranet. This has to be defined before any script/style tags.
    </tal:comment>
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <metal:baseslot define-slot="base">
        <base tal:attributes="href plone_view/renderBase" /><!--[if lt IE 7]></base><![endif]-->
    </metal:baseslot>

    
    <script type="text/javascript" src="jquery-1.5.1.min.js"></script> 
    <script type="text/javascript" src="jquery.tinysort.js"></script>
    <link rel="stylesheet" href="dezurstva.css" type="text/css" /> 

    <script>
	$(document).ready(function() {
		$('select#oseba option').tsort();
	});

    </script> 

    
    
</head>

<body tal:define="isRTL portal_state/is_rtl;
                  sl python:plone_view.have_portlets('plone.leftcolumn', view);
                  sr python:plone_view.have_portlets('plone.rightcolumn', view);
                  body_class python:plone_view.bodyClass(template, view);
                  sunburst_view python:context.restrictedTraverse('@@sunburstview');
		lan python: context.portal_languages.getPreferredLanguage();
                    dod python: lan != 'sl' and ('-' + lan) or '';
                    
                    url_tokens python: context.REQUEST.getURL().split('/');
                    is_front python: context.absolute_url() == portal_url;
                    
                    prva python: is_front and 'prva_stran' or '';
		 last_change python: context.portal_catalog(portal_type = 'dezurstvo', sort_on = 'modified', sort_order = 'descending')[0]"
    tal:attributes="class body_class;
                    dir python:isRTL and 'rtl' or 'ltr'">

	<div id="last-change">	
		<span>Zadnja sprememba: </span><span tal:define="datum last_change/modified; dat python: '.'.join([str(datum).split(' ')[0].split('/')[2], str(datum).split(' ')[0].split('/')[1], str(datum).split(' ')[0].split('/')[0]])" tal:content="dat" /> 
		<span> ob </span>
		<span tal:define="datum last_change/modified; dat python: ':'.join([str(datum).split(' ')[1].split(':')[0], str(datum).split(' ')[1].split(':')[1]])" tal:content="dat" />
	</div>
                    
    
	<script type="text/JavaScript">
        	var now = new Date();
		var night = new Date(
		    now.getFullYear(),
		    now.getMonth(),
		    now.getDate() + 1, // the next day, ...
		    0, 0, 10 // ...at 00:00:00 hours
		);
		var msTillMidnight = night.getTime() - now.getTime();
		if (msTillMidnight > 0) setTimeout('location.reload(true)', msTillMidnight);

      </script>
	<div id="okolo">
          <div id="okol" >              
		            
              		
			





		
	





	<div tal:define="dans python: str(DateTime()).split(' ')[0].replace('/', '-'); 
		dat here/REQUEST/form/datum|nothing; danes python: dat and dat or str(DateTime()).split(' ')[0].replace('/', '-'); 
		dezurstvo python: context.portal_catalog(portal_type = 'dezurstvo', id = danes); 
		dezurstvo python: len(dezurstvo) > 0 and dezurstvo[0] or nothing; 
		oseba here/REQUEST/form/oseba|nothing; 
		seznam python: oseba and context.portal_catalog.searchResults(priprava_vzorcev = oseba, portal_type = 'dezurstvo', sort_on='id', sort_order='ascending') or nothing; 
		dnevi python: {'Monday':'ponedeljek', 'Tuesday':'torek', 'Wednesday':'sreda', 'Thursday':'četrtek', 'Friday':'petek', 'Saturday':'sobota', 'Sunday':'nedelja'}" tal:condition="python: 'spremeni-dezurstvo' not in url_tokens">

	
<tal:ret condition="not: oseba">
	
	<table class="glava" cellpading="0" cellspacing="0"><tr>
		<td width="80px" style="background: url(logo.png) no-repeat"></td>
            	<td width="40%"><h1><a tal:attributes="href portal_url">KIESTRA</a></h1>  </td>             



		<td>
		<a style="margin-top: 4px; width: 28%; margin-right: 5%; float: left; text-align: right; font-size: 24px; font-family: Tahoma, sans-serif" tal:attributes="href python: '?datum=' + str(DateTime(danes) - 1).split(' ')[0].replace('/', '-')">Nazaj</a>
		<h2 style="width: 33%; float: left; text-align: center"><tal:tr condition="python: dans == danes">danes, </tal:tr><tal:tr content="python: dnevi[DateTime(danes).strftime('%A')] + ', ' + '.'.join([danes.split('-')[2], danes.split('-')[1], danes.split('-')[0]])"></tal:tr></h2>
		<a style="margin-top: 4px; width: 25%; margin-left: 5%; float: left; text-align: left; font-size: 24px;  font-family: Tahoma, sans-serif" tal:attributes="href python: '?datum=' + str(DateTime(danes) + 1).split(' ')[0].replace('/', '-')">Naprej</a>

		</td>
	</tr></table>

	<div style="clear: both">&nbsp;</div>
	
	
	<br />
	<tal:kerw condition="dezurstvo">
	

	<table class="dezurstva" cellpading="0" cellspacing="0" tal:condition="dezurstvo" tal:define="tabelca python: []; tabelca_opomb python: [];
 		dummy python: tabelca.append(dezurstvo.getObject().priprava_vzorcev);
		dummy python: tabelca.append(dezurstvo.getObject().cepljenje_vzorcev);
		dummy python: tabelca.append(dezurstvo.getObject().odcitavanje);
		dummy python: tabelca.append(dezurstvo.getObject().identifikacija);
		dummy python: tabelca.append(dezurstvo.getObject().antibiogram);
		dummy python: tabelca.append(dezurstvo.getObject().izolacija);
		dummy python: tabelca.append(dezurstvo.getObject().odpad);
		dummy python: tabelca.append(dezurstvo.getObject().ciscenje);

   		dummy python: tabelca_opomb.append(dezurstvo.getObject().priprava_vzorcev_text);
		dummy python: tabelca_opomb.append(dezurstvo.getObject().cepljenje_vzorcev_text);
		dummy python: tabelca_opomb.append(dezurstvo.getObject().odcitavanje_text);
		dummy python: tabelca_opomb.append(dezurstvo.getObject().identifikacija_text);
		dummy python: tabelca_opomb.append(dezurstvo.getObject().antibiogram_text);
		dummy python: tabelca_opomb.append(dezurstvo.getObject().izolacija_text);
		dummy python: tabelca_opomb.append(dezurstvo.getObject().odpad_text);
		dummy python: tabelca_opomb.append(dezurstvo.getObject().ciscenje_text);

		maksi python: [len(i) for i in tabelca];
		arr python: range(max(maksi)+2);
		app python: context.restrictedTraverse('/'); 
		zaposleni python: app['dezurstva']; 
	">
		<tr class="head">
			<th>Priprava vzorcev</th>
			<th>Inoqula + Sortera</th>
			<th>Odčitavanje</th>
			<th>Ime bakterije</th>
			<th>ID+ATB, ATB, izolacija</th>

		  
			<!--<th>Waste</th>-->
			<th>OFF</th>
			<!--<th>Čiščenje kiestre</th>-->

		  

		</tr>
		<tr style="background: white !important" tal:repeat="num arr">
		

			



			<tal:rep repeat="ar python: range(7)">
				<td width="12.5%" tal:define="oseba python: len(tabelca[ar]) > num and zaposleni.portal_catalog(id=tabelca[ar][num]) or ''; oseba python: len(oseba) > 0 and oseba[0].Title or ''; oseba python: len(tabelca[ar]) == num and '' or oseba; oseba python: (oseba and oseba[:6] != '<span>') and oseba.strip().split(' ')[0] + ' ' + oseba.strip().split(' ')[-1][0] + '.' or oseba" tal:content="structure oseba" tal:condition="python: ar != 5"></td>			
			</tal:rep>


		</tr>

		<tr style="background: white !important">
			<tal:rep repeat="ar python: range(7)">
				<td  tal:condition="python: ar != 5" style="border-top: 1px solid black" tal:define="oseba python: '<span>' + tabelca_opomb[ar] + '</span>'" tal:content="structure oseba"></td>	
			</tal:rep>	

		</tr>
		
		
	</table>

	<table class="dezurstva" cellpading="0" cellspacing="0" tal:condition="dezurstvo">
		
		<tr>
			<td style="background: white !important; padding: 50px 30px" tal:content="python: dezurstvo.getObject().stalni_tekst"></td>				
		</tr>
	</table>

	

	
	</tal:kerw>
	<p tal:condition="not: dezurstvo">Razpored za ta datum še ni določen.</p> 
	

	
	


</tal:ret>

<tal:ret condition="oseba" define="app python: context.restrictedTraverse('/'); 
		zaposleni python: app['dezurstva']; 
		leta python: []; mesci python: []; 
		dummy python: (oseba and seznam) and [leta.append(x.id[:4]) for x in seznam if x.id[:4] not in leta]; 
		dummy python: (oseba and seznam) and [mesci.append(x.id[5:7]) for x in seznam if x.id[5:7] not in mesci]; 
		meseci python: {'01':'januar', '02':'februar', '03':'marec', '04':'april', '05':'maj', '06':'junij', '07':'julij', '08':'avgust', '09':'september', '10':'oktober', '11':'november', '12':'december'}; 
		dummy python: mesci.sort(reverse=True); dummy python: leta.sort(reverse=True)">
	



	<h2>Dežurstva za osebo <span style="color: #5fb11e" tal:content="python: zaposleni.portal_catalog(id=oseba)[0].getObject().Title()"></span></h2>
		
	<p>&nbsp;</p>
	<tal:rep1 repeat="leto leta">
		<h3 tal:content="leto"></h3>	
		<tal:rep2 repeat="mesec mesci">	
			<h4 tal:content="python: meseci[mesec]"></h4>	
			<tal:rep3 define="seznam2 python: [x.id for x in seznam if (leto + '-' + mesec) in x.id]; dummy python: seznam2.sort(reverse=True)" repeat="item seznam2">				
				<a style="font-family: Tahoma, sans-serif;" tal:attributes="href python: '?datum=' + item" tal:content="python: '.'.join([item.split('-')[2], item.split('-')[1], item.split('-')[0]])">Nazaj</a><br />
			</tal:rep3>
		</tal:rep2>
	</tal:rep1>
	<p>&nbsp;</p>
	

	

</tal:ret>


<p>&nbsp;</p>
<hr />

	<link rel="stylesheet" href="jquery-ui.min.css" type="text/css" media="screen, projection" />	  
	<script type="text/javascript" src="jquery-ui.min.js"></script> 
  	
	<script>

	function DoSubmit(){
		var nov = document.poslji_datum.datum.value;	 
		nov = nov.split('.')[2] + '-' + nov.split('.')[1] + '-' + nov.split('.')[0];
		document.poslji_datum.datum.value = nov;
	  	return true;
	}



	  $(function() {
	    $( ".datepicker" ).datepicker({
	      dateFormat: "dd.mm.yy"
	    });
	  });
	</script>
	
	<div style="float: left; width: 49%">	
	<form action="" onsubmit="DoSubmit();" name="poslji_datum">
		<p>Prikaži razpored na izbrani datum: </p><input name="datum" tal:attributes="value python: '.'.join([danes.split('-')[2], danes.split('-')[1], danes.split('-')[0]])" type="text" class="datepicker">
		<input style="display: inline" type="submit" value="Prikaži" style="cursor: pointer" />
	</form>
	</div>
	
	<div style="float: left; width: 49%">	
	<form action="">
		<p>Prikaži vsa dežurstva za osebo:</p>
		<select name="oseba" id="oseba">
			<option></option>				
			<tal:rep repeat="os python: context.portal.restrictedTraverse('/dezurstva/seznam_zaposlenih/').getFolderContents()">
				<option tal:attributes="value os/id" tal:content="os/Title"></option>
			</tal:rep>
		</select>
		<input style="display: inline" type="submit" value="Prikaži" style="cursor: pointer" />
	</form>
	</div>

	
			</div>



			<script>
				  $( "#archetypes-fieldname-ime-in-priimek select" ).change(function () {
		
				    if ($('#archetypes-fieldname-ime-in-priimek option:selected').val().substring(0, 2) != '41') $('#archetypes-fieldname-replyto input').val($( "#archetypes-fieldname-ime-in-priimek option:selected" ).val());
				    else $('#archetypes-fieldname-replyto input').val('');
				  });


			</script>


     		</div>
             
             
     	</div>   



	<script>
		$('span.required').html('*');
	</script>
</body>
</html>

</metal:page>
